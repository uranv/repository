#!name=防災速報去广告
#!desc=移除 Yahoo! 防災速報原生广告、网页广告占位及本家 App 推广；以即时无广告响应避免页面持续“読み込み中”
#!openUrl=https://apps.apple.com/app/id481914139
#!author=ChatGPT 5.6 Sol max
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.4.0(962)
#!icon=https://raw.githubusercontent.com/uranv/repository/refs/heads/main/fig/481914139x256.png
#!date=2026-09-23 0:38:56

[Rewrite]
# 两个主页原生广告位：按广告位地址直接返回结构完整的 noad 数据，避免丢包后的延迟收起。
^https:\/\/aag\.yahooapis\.jp\/v2\/ads\/elookup\?[^#]*adunit_id=Mr2mlYI9s2M4VAYA0RDdVwofzl905420(?:&|$) mock-response-body data-type=json data="" mock-data-is-base64=true status-code=200
^https:\/\/aag\.yahooapis\.jp\/v2\/ads\/elookup\?[^#]*adunit_id=ohqAo2n3xqRnFXYzDjNuY1JLAM907200(?:&|$) mock-response-body data-type=json data="" mock-data-is-base64=true status-code=200

# 网页推广接口
^https:\/\/yads\.yjtag\.yahoo\.co\.jp\/v2\/(?:tag|yda)\? response-body-json-jq '{"responseType":"noad","data":{"noAdCallback":"","reason":3}}'
^https:\/\/mempf\.yahoo\.co\.jp\/v2\/offer\? response-body-json-jq 'with_entries(.value|=(.contents=[""]|.imps_base_url=""|.offer_id=0|.aggregate_id=0))'

# 雨云／雷达页：广告栏元素与对应广告加载器
^https:\/\/weather\.yahoo\.co\.jp\/weather\/zoomradar(?:\/lightning)?\/(?:\?|$) response-body-replace-regex <div\b(?=[^>]*\bclass=\x22[^\x22]*\brainRadarAd\b[^\x22]*\x22)[^>]*>\s*<div\b(?=[^>]*\bid=\x22ad1\x22)[^>]*>\s*<\/div>\s*<\/div> \x20 <script\b(?=[^>]*\bsrc=\x22https:\/\/yads\.c\.yimg\.jp\/js\/yads-async\.js(?:\?[^\x22]*)?\x22)[^>]*>\s*<\/script> \x20

# 台风、气象警报、地震与灾害日历页：广告／App 推广节点及其专属脚本
^https:\/\/typhoon\.yahoo\.co\.jp\/weather\/(?:jp\/(?:typhoon|warn|earthquake)\/|calendar\/) response-body-replace-regex <script\b(?=[^>]*\bsrc=\x22https:\/\/yads\.c\.yimg\.jp\/js\/yads-async\.js(?:\?[^\x22]*)?\x22)[^>]*>\s*<\/script> \x20 <div\b(?=[^>]*\bid=\x22ydn-top\x22)[^>]*>\s*<\/div> \x20 <script\b[^>]*>(?:(?!<\/script>)[\s\S])*\bYJ_YADS\b(?:(?!<\/script>)[\s\S])*<\/script> \x20 <aside\b[^>]*>\s*<p\b[^>]*>\s*<a\b(?=[^>]*\bid=\x22s_iphone_(?:typhoon|warn|earthquake)_banner_a\x22)[^>]*>[\s\S]*?<\/a>\s*<\/p>\s*<\/aside> \x20 <script\b[^>]*>(?:(?!<\/script>)[\s\S])*\bs_iphone_(?:typhoon|warn|earthquake)_banner_(?:a|img)\b(?:(?!<\/script>)[\s\S])*<\/script> \x20 <div\b(?=[^>]*\bid=\x22apywthdl\x22)[^>]*>[\s\S]*?<!--\s*\/\.promoApp\s*-->[\s\S]*?<\/aside>\s*<\/div> \x20 <div\b(?=[^>]*\bclass=\x22[^\x22]*\bfooterPromo\b[^\x22]*\x22)[^>]*>[\s\S]*?<\/a>\s*<\/div> \x20

[MitM]
hostname=aag.yahooapis.jp, yads.yjtag.yahoo.co.jp, mempf.yahoo.co.jp, weather.yahoo.co.jp, typhoon.yahoo.co.jp
